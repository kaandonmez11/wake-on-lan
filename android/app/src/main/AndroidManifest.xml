<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Haptikler (spec 12.7, 14). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Ağ (spec 7, 14). Bildirim, alarm ve açılış izinleri ilgili sprintlerde eklenir. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17: yerel ağ erişimi runtime izni (targetSdk 37). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- SSID okumak için (Wi-Fi pill, "eve gelince"). Kesin konum yaklaşıkla birlikte istenir. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Zamanlayıcılar (spec 9.4): sideload uygulamada kurulumda verilen tam saatli alarm, açılışta yeniden kurma. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Zamanlayıcı "Bildirim gönder" (S08, Kaan) ve S09 başarısız bildirimi. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ayarlar › Pil: "Kısıtlanmamış" isteği (spec 9.4, 14). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".WolApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wol">

        <!-- S13: macrobenchmark / baseline profile ölçümü için (adb shell profillemesi). -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tile güç paneli (S12, mod A): şeffaf, son uygulamalarda görünmez. -->
        <activity
            android:name=".tile.TilePowerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Wol.Translucent" />

        <!-- Hızlı Ayarlar tile'ları (spec 10.8): 3 sabit slot. -->
        <service
            android:name=".tile.WolTileService1"
            android:exported="true"
            android:icon="@drawable/ic_stat_app"
            android:label="WoL 1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tile.WolTileService2"
            android:exported="true"
            android:icon="@drawable/ic_stat_app"
            android:label="WoL 2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tile.WolTileService3"
            android:exported="true"
            android:icon="@drawable/ic_stat_app"
            android:label="WoL 3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Zamanlayıcı alarmı (spec 9.4): paketleri hemen gönderir, doğrulamayı VerifyWorker'a bırakır. -->
        <receiver
            android:name=".domain.schedule.ScheduleAlarmReceiver"
            android:exported="false" />

        <!-- Retry zinciri alarmı (S09). -->
        <receiver
            android:name=".domain.schedule.RetryAlarmReceiver"
            android:exported="false" />

        <!-- "Eve gelince": Wi-Fi bağlanınca sistemin gönderdiği PendingIntent (S09). -->
        <receiver
            android:name=".domain.schedule.WifiTriggerReceiver"
            android:exported="false" />

        <!-- Açılış, güncelleme, saat ve saat dilimi değişimi → tüm alarmlar yeniden. -->
        <receiver
            android:name=".domain.schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
